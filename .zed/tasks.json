[
  {
    "label": "build",
    "command": "powershell",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "./build.ps1 -Preset debug"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
