    "reveal": "always",
    "allow_concurrent_runs": false
  },
  {
    "label": "build web",
    "command": "powershell",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "./build_web.ps1"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "allow_concurrent_runs": false
  },
  {
    "label": "build & run web",
    "command": "powershell",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "./build_web.ps1 -Run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "allow_concurrent_runs": false
